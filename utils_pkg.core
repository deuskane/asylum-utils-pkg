# 2026-07-29  1.7.1    mrosiere string_pkg : Add to_string
# 2026-09-05  1.7.2    mrosiere ft_pkg     : Add testbench
#-----------------------------------------------------------------------------

name        : asylum:utils:pkg:1.7.2
description : VHDL Utility Package

#=========================================
filesets:
#=========================================

  #---------------------------------------
  # Source Files
  #---------------------------------------

  #---------------------------------------
  files_hdl:
  #---------------------------------------
    files:
      - hdl/convert_pkg.vhd
      - hdl/logic_pkg.vhd
      - hdl/math_pkg.vhd
      - hdl/pbi_pkg.vhd
      - hdl/sbi_pkg.vhd
      - hdl/string_pkg.vhd
      - hdl/ft_pkg.vhd
      - hdl/ft_pkg_body.vhd

      - hdl/ft_enc.vhd
      - hdl/ft_dec.vhd
      - hdl/ft_dff.vhd
      
    file_type    : vhdlSource-2008
    logical_name : asylum

  #---------------------------------------
  pkg_ieee_dummy:
  #---------------------------------------
    files:
      - hdl/vital/vital_timing.vhdl
      - hdl/vital/vital_timing-body.vhdl
      - hdl/vital/vital_primitives.vhdl
      - hdl/vital/vital_primitives-body.vhdl
    logical_name : IEEE_dummy
    file_type    : vhdlSource-2008    

  #---------------------------------------
  sim:
  #---------------------------------------
    files:
      - sim/tb_ft_none.vhd
      - sim/tb_ft_parity_odd.vhd
      - sim/tb_ft_parity_even.vhd
      - sim/tb_ft_tmr.vhd
      - sim/tb_ft_ecc.vhd
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm 

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description : Default Target
    filesets    :
      - files_hdl
      - pkg_ieee_dummy

  #---------------------------------------
  sim: &sim
  #---------------------------------------
    << : *default
    description     : Default Target for Simulation
    filesets_append :
      - sim
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-frelaxed"]
        run_options     : ["--fst=dut.fst"]

  #---------------------------------------
  sim_ft_none:
  #---------------------------------------
    << : *sim
    description     : Unit test for NONE algorithm
    toplevel        : tb_ft_none

  #---------------------------------------
  sim_ft_parity_odd:
  #---------------------------------------
    << : *sim
    description     : Unit test for parity odd algorithm
    toplevel        : tb_ft_parity_odd

  #---------------------------------------
  sim_ft_parity_even:
  #---------------------------------------
    << : *sim
    description     : Unit test for parity even algorithm
    toplevel        : tb_ft_parity_even

  #---------------------------------------
  sim_ft_tmr:
  #---------------------------------------
    << : *sim
    description     : Unit test for TMR algorithm
    toplevel        : tb_ft_tmr

  #---------------------------------------
  sim_ft_ecc:
  #---------------------------------------
    << : *sim
    description     : Unit test for ECC algorithm
    toplevel        : tb_ft_ecc

  #---------------------------------------
  emu_ng_medium_ft_dff_none : &emu_ng_medium_default
  #---------------------------------------
    << : *default
    description  : NanoXplore NG_MEDIUM with tf_dff none
    default_tool : nxmap
    filesets     :
      - files_hdl
      - files_ng_medium 
      - pbcc_dep
    parameters   :
      - WIDTH=32
      - FT_ALGO=0
      - SELF_REFRESH=false
    tools:
      nxmap:
        fpga         : NG-MEDIUM-EMBEDDED
        program      : False
        logical_name : asylum
    toplevel : ft_dff

#=========================================
parameters :
#=========================================

  WIDTH :
    description : Data Width
    datatype    : int
    default     : 32
    paramtype   : generic

  FT_ALGO :
    description : Fault Tolerant Algo
    datatype    : int
    default     : 0
    paramtype   : generic

  SELF_REFRESH :
    description : Rewrite in DFF
    datatype    : bool
    default     : false
    paramtype   : generic